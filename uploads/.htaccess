# GaunGaliHat Uploads Security Hardening (Item 17)
# Prevent script execution with Apache 2.4 ("Require all denied") and legacy 2.2 fallback
<FilesMatch "\.(?i:php|phtml|php[3-8]|phps|phar|cgi|pl|exe|sh|py|shtml|pht)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order Deny,Allow
        Deny from all
    </IfModule>
</FilesMatch>

# Disable PHP engine across all PHP handler variants
<IfModule mod_php.c>
    php_flag engine off
</IfModule>
<IfModule mod_php7.c>
    php_flag engine off
</IfModule>
<IfModule mod_php8.c>
    php_flag engine off
</IfModule>

# Strip script execution MIME mappings
RemoveHandler .php .phtml .php3 .php4 .php5 .php7 .php8 .phar .cgi .pl
RemoveType .php .phtml .php3 .php4 .php5 .php7 .php8 .phar .cgi .pl

# Deny directory listing and CGI execution
Options -ExecCGI -Indexes
