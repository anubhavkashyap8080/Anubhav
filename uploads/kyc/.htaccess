# GanvGaliHat Protected KYC Storage (Security Audit H3)
# Direct public web access to seller KYC documents is strictly forbidden.
# Documents can only be viewed by authenticated administrators via /admin/view_kyc.php
<IfModule mod_authz_core.c>
    Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
    Order deny,allow
    Deny from all
</IfModule>
