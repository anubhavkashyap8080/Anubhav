# ==============================================================================
# GaunGaliHat Enterprise Web Server Configuration & Security Hardening
# Apache 2.4+ / cPanel Optimized
# ==============================================================================

# Ensure index.php is loaded as the primary root document
DirectoryIndex index.php index.html index.htm

# Force UTF-8 Encoding globally to eliminate any Mojibake character issues
AddDefaultCharset UTF-8
<IfModule mod_mime.c>
    AddCharset UTF-8 .html .php .js .css .json .xml
</IfModule>

# Disable Directory Browsing
Options -Indexes

# Item 28: Prevent Access to Hidden Files, Git, Databases, Configs, Logs, and Source Files
<FilesMatch "(^\.|\.(sqlite|sql|db|bak|config|env|log|md|json|ts|tsx|lock|ini|sample)$)">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order Deny,Allow
        Deny from all
    </IfModule>
</FilesMatch>

# Explicitly Protect Sensitive Files
<Files "schema.sql">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order Deny,Allow
        Deny from all
    </IfModule>
</Files>
<Files "migration_security_hardening.sql">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order Deny,Allow
        Deny from all
    </IfModule>
</Files>
<Files "gaungalihat.sqlite">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order Deny,Allow
        Deny from all
    </IfModule>
</Files>
<Files ".user.ini">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order Deny,Allow
        Deny from all
    </IfModule>
</Files>

# Item 28: Security HTTP Response Headers
<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "SAMEORIGIN"
    Header set Referrer-Policy "strict-origin-when-cross-origin"
    Header set Permissions-Policy "camera=(), microphone=(), payment=(self)"
    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
    # Deprecated header removed per security audit Item 28
    Header unset X-XSS-Protection
    Header set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://cdn.tailwindcss.com https://unpkg.com https://cdnjs.cloudflare.com https://challenges.cloudflare.com https://accounts.google.com https://checkout.razorpay.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://cdnjs.cloudflare.com; font-src 'self' https://fonts.gstatic.com https://cdnjs.cloudflare.com data:; img-src 'self' data: https:; connect-src 'self' https://challenges.cloudflare.com https://lumberjack.razorpay.com; frame-src 'self' https://challenges.cloudflare.com https://accounts.google.com https://api.razorpay.com; object-src 'none'; base-uri 'self';"
</IfModule>

# Item 27: Disable Error Display on Production
<IfModule mod_php.c>
    php_flag display_errors Off
    php_flag log_errors On
</IfModule>
<IfModule mod_php7.c>
    php_flag display_errors Off
    php_flag log_errors On
</IfModule>
<IfModule mod_php8.c>
    php_flag display_errors Off
    php_flag log_errors On
</IfModule>

# URL Rewriting & Sensitive Directory Protection
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # Item 28: Deny direct web access to sensitive internal directories
    RewriteRule ^(config|includes|database|data|functions|src|scripts|\.git)(/|$) - [F,L,NC]

    # Serve sitemap.xml dynamically from sitemap generator
    RewriteRule ^sitemap\.xml$ sitemap.php [L]
    RewriteRule ^sitemap-([a-z]+)\.xml$ sitemap.php?type=$1 [L]
    RewriteRule ^robots\.txt$ robots.php [L]
</IfModule>
