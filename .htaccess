# ==============================================================================
# GaunGaliHat Enterprise Web Server Configuration & Security Hardening
# ==============================================================================

# Ensure index.php is loaded as the primary root document
DirectoryIndex index.php index.html index.htm

# Force UTF-8 Encoding globally to eliminate any Mojibake character issues
AddDefaultCharset UTF-8
<IfModule mod_mime.c>
    AddCharset UTF-8 .html .php .js .css .json .xml
</IfModule>

# Disable Directory Browsing
Options -Indexes

# Prevent Access to Hidden Files, Git, Databases, and Configs
<FilesMatch "(^\.|\.(sqlite|sql|db|bak|config|env|log|md|json|ts|lock)$)">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order Deny,Allow
        Deny from all
    </IfModule>
</FilesMatch>

# Explicitly Protect Sensitive System Files
<Files "schema.sql">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order Deny,Allow
        Deny from all
    </IfModule>
</Files>
<Files "gaungalihat.sqlite">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order Deny,Allow
        Deny from all
    </IfModule>
</Files>

# Security HTTP Response Headers
<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "SAMEORIGIN"
    Header set X-XSS-Protection "1; mode=block"
    Header set Referrer-Policy "strict-origin-when-cross-origin"
    Header set Permissions-Policy "camera=(), microphone=(), payment=(self)"
</IfModule>

# URL Rewriting for Sitemaps, Robots, and Static Feeds
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # Serve sitemap.xml dynamically from sitemap generator if needed
    RewriteRule ^sitemap\.xml$ sitemap.php [L]
    RewriteRule ^sitemap-([a-z]+)\.xml$ sitemap.php?type=$1 [L]
    RewriteRule ^robots\.txt$ robots.php [L]
</IfModule>
